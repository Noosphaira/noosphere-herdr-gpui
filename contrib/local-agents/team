#!/usr/bin/env python3
"""Work in your team. Available inside a launched team's sandbox.

  team info                      your role, your stages, whose turn it is, the task
  team status                    every teammate's state (working, idle, ...)
  team done <summary>            your turn is done and committed: the team runs the
                                 stage's check and moves the work on
  team findings <findings>       (stages that allow it) send numbered findings on
  team blocked <what failed>     you can't go on (a tool can't run): notify the user, stop
  team ask <role> <question>     ask a teammate; `-` reads it from stdin
  team answer <role> <answer>    answer a teammate's question

Only the role whose turn it is reports done or findings. Asking and answering
never change whose turn it is.
"""

import json
import os
import socket
import sys


def call(method, params=None):
    path = os.environ.get("HERDR_SOCKET_PATH")
    if not path or not os.environ.get("HERDR_TEAM_ROLE"):
        sys.exit("team: not running inside a launched team")
    request = json.dumps({"id": f"team:{method}", "method": method, "params": params or {}})
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(30)
        conn.connect(path)
        conn.sendall(request.encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
    answer = json.loads(data or b"{}")
    if "error" in answer:
        sys.exit(f"team: {answer['error'].get('message', 'failed')}")
    return answer.get("result", {})


def text(args):
    return sys.stdin.read() if args == ["-"] else " ".join(args)


def main():
    args = sys.argv[1:]
    command = args[0] if args else "info"
    if command in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif command == "info":
        info = call("team.info")
        print(f"You are: {info['role']}")
        print(f"Turn:    {info['turn'] or '(not started)'} (stage {info['stage']})")
        for name, stage in info["your_stages"].items():
            moves = ", ".join(f"{key} -> {stage[key]}" for key in ("next", "pass", "fail", "findings") if key in stage)
            check = f"check `{stage['check']}`; " if "check" in stage else ""
            print(f"Stage {name}: {check}{moves}")
        print(f"Team:    {', '.join(info['roles'])}")
        print(f"Branch:  {info['branch']}")
        if info["done"] or info["stopped"]:
            print(f"\nThe team has {'stopped: ' + info['stopped'] if info['stopped'] else 'finished'}.")
        print(f"\nTask:\n{info['task']}")
    elif command == "status":
        info = call("team.status")
        for role, status in info["statuses"].items():
            marker = "  <- you" if role == info["role"] else ""
            turn = "  (its turn)" if role == info["turn"] else ""
            print(f"{role:<16} {status}{turn}{marker}")
    elif command == "done":
        result = call("team.done", {"summary": text(args[1:])})
        print(f"reported done: {result['next']}")
    elif command == "findings" and len(args) >= 2:
        result = call("team.findings", {"text": text(args[1:])})
        print(f"reported findings: {result['next']}")
    elif command == "blocked" and len(args) >= 2:
        call("team.blocked", {"text": text(args[1:])})
        print("the user has been notified and your pane is marked; stop now")
    elif command in ("ask", "answer") and len(args) >= 3:
        result = call(f"team.{command}", {"to": args[1], "text": text(args[2:])})
        print(f"sent to {args[1]}")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
