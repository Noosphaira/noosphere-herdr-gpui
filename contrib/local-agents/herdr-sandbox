#!/usr/bin/env python3
"""Run one command inside bubblewrap, confined to a git worktree.

Usage: herdr-sandbox [--team-dir DIR --role ROLE] <worktree> -- <command> [args...]

Binds the worktree and its repo's common .git read-write (hooks read-only),
the agent's config read-only and its data directories read-write (OpenCode or
Pi, by executable name; see herdr_agents.py), and the grants from
~/.config/herdr-launch/{global,repos}.yaml. The rest of the home directory is
an empty tmpfs.

`sandbox_env` in ~/.config/herdr-launch/settings.yaml sets extra variables
inside every sandbox, e.g. where to send traces. Values may use {agent},
{role} and {branch} (empty outside a team):

    sandbox_env:
      OPIK_URL: http://127.0.0.1:5173/api
      OPIK_PROJECT_NAME: teams-{agent}

The agent runs in the systemd user slice herdr-agents.slice, where a root
nftables service on the host limits where it may connect (see
herdr_netfilter.py). Unless settings.yaml says `network_filter: off`, no
agent starts while that filter is not active.

herdr's control socket is never bound in. Anything that can write to it can
run commands in any pane, outside the sandbox. Instead, a filter socket is
bound in (see herdr_filter.py): it forwards this pane's agent-state reports
and, for a launched team, the `team` command's messages to teammates.
"""

import os
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import herdr_agents  # noqa: E402
import herdr_filter  # noqa: E402
import herdr_grants  # noqa: E402
import herdr_netfilter  # noqa: E402
import herdr_team  # noqa: E402

LAUNCH_DIR = Path(__file__).resolve().parent

HOME = Path.home()

ETC_FILES = [
    "passwd", "group", "hosts", "nsswitch.conf", "localtime", "ld.so.cache",
    "ssl", "ca-certificates", "resolv.conf",
]

ENV_PASSTHROUGH = [
    "TERM", "COLORTERM", "TERM_PROGRAM", "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE",
    "LC_MESSAGES", "TZ", "USER", "LOGNAME", "SHELL",
    "HERDR_ENV", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID",
    # The report a team's stage check judges (herdr-team-watch).
    "TEAM_REPORT",
]

SANDBOX_SOCKET_DIR = "/run/herdr-filter"
# The `team` command, bound read-only with the module it needs.
SANDBOX_TEAM_DIR = "/run/herdr-team"
SETTINGS = herdr_grants.CONFIG_DIR / "settings.yaml"


def die(message):
    print(f"herdr-sandbox: {message}", file=sys.stderr)
    sys.exit(2)


def git(*args, cwd):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"git {' '.join(args)} failed in {cwd}: {result.stderr.strip()}")
    return result.stdout.strip()


# --- bubblewrap command ------------------------------------------------------

def bind_args(flag, source, target=None):
    return [flag, str(source), str(target or source)]


def run_env(team):
    """The team run's id and setup version, so agents can tag their traces
    (README "Runs and traces"). Empty for a team from before run ids."""
    if "run_id" not in team:
        return {}
    return {"HERDR_TEAM_RUN": team["run_id"], "HERDR_SETUP_VERSION": team["setup"]["version"]}


def sandbox_env(agent, role, branch, run=""):
    """`sandbox_env` from the launcher settings, placeholders filled in."""
    settings = herdr_grants.read_yaml(SETTINGS, {})
    env = settings.get("sandbox_env") if isinstance(settings, dict) else None
    if not isinstance(env, dict):
        return {}
    values = {"agent": agent, "role": role or "", "branch": branch or "", "run": run or ""}
    out = {}
    for name, value in env.items():
        try:
            out[str(name)] = str(value).format(**values)
        except (KeyError, IndexError, ValueError) as error:
            die(f"{SETTINGS} sandbox_env {name}: {error}")
    return out


def build_bwrap(worktree, common_git, grants, command, filter_dir, role=None, branch=None, prompt=None, run=None):
    executable = Path(shutil.which(command[0]) or command[0]).resolve()
    if not executable.is_file():
        die(f"command not found: {command[0]}")
    agent_dirs = herdr_agents.sandbox_dirs(executable)
    args = [
        "bwrap",
        "--die-with-parent",
        "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try",
        "--proc", "/proc",
        "--dev", "/dev",
        "--tmpfs", "/tmp",
        "--ro-bind", "/usr", "/usr",
        "--symlink", "usr/bin", "/bin",
        "--symlink", "usr/bin", "/sbin",
        "--symlink", "usr/lib", "/lib",
        "--symlink", "usr/lib", "/lib64",
    ]
    for name in ETC_FILES:
        source = Path("/etc", name)
        if source.exists():
            # resolv.conf is a symlink into /run; bind its target in its place.
            args += bind_args("--ro-bind", source.resolve(), source)

    args += ["--tmpfs", str(HOME)]
    for sub in agent_dirs["read_only"]:
        path = HOME / sub
        path.mkdir(parents=True, exist_ok=True)
        args += bind_args("--ro-bind", path)
    for sub in agent_dirs["entries_read_only"]:
        folder = HOME / sub
        folder.mkdir(parents=True, exist_ok=True)
        args += ["--tmpfs", str(folder)]
        for entry in sorted(folder.iterdir()):
            if not entry.name.endswith(".lock"):
                args += bind_args("--ro-bind", entry)
    for sub in agent_dirs["read_write"]:
        path = HOME / sub
        path.mkdir(parents=True, exist_ok=True)
        args += bind_args("--bind", path)

    for path in grants["read_only"]:
        args += bind_args("--ro-bind", path)
    for path in grants["read_write"]:
        args += bind_args("--bind", path)

    args += bind_args("--bind", common_git)
    args += bind_args("--bind", worktree)
    # Later binds win, so hooks stay read-only over the read-write .git.
    hooks = common_git / "hooks"
    if hooks.is_dir():
        args += bind_args("--ro-bind", hooks)

    if not str(executable).startswith("/usr/"):
        args += bind_args("--ro-bind", executable.parent if agent_dirs["install_dir"] else executable)

    if filter_dir:
        args += bind_args("--ro-bind", filter_dir, SANDBOX_SOCKET_DIR)
    if role:
        args += bind_args("--ro-bind", LAUNCH_DIR / "team", f"{SANDBOX_TEAM_DIR}/team")
    if prompt:
        args += bind_args("--ro-bind", prompt, herdr_agents.PROMPT_IN_SANDBOX)

    args += ["--clearenv"]
    for name in ENV_PASSTHROUGH + grants["env"]:
        if name in os.environ:
            args += ["--setenv", name, os.environ[name]]
    path_dirs = [str(executable.parent)] + grants["path"] + ["/usr/local/bin", "/usr/bin"]
    if role:
        path_dirs.insert(0, SANDBOX_TEAM_DIR)
        args += ["--setenv", "HERDR_TEAM_ROLE", role]
    if branch:
        args += ["--setenv", "HERDR_TEAM_BRANCH", branch]
    for name, value in (run or {}).items():
        args += ["--setenv", name, value]
    args += ["--setenv", "HOME", str(HOME), "--setenv", "PATH", ":".join(path_dirs)]
    args += ["--setenv", "HERDR_SANDBOX", "1"]
    agent = executable.name if executable.name in herdr_agents.AGENTS else herdr_agents.DEFAULT
    run_id = (run or {}).get("HERDR_TEAM_RUN", "")
    for name, value in {**sandbox_env(agent, role, branch, run_id), **herdr_agents.OFFLINE_ENV}.items():
        args += ["--setenv", name, value]
    if filter_dir:
        args += ["--setenv", "HERDR_SOCKET_PATH", f"{SANDBOX_SOCKET_DIR}/herdr.sock"]
    args += ["--chdir", str(worktree), "--", str(executable), *command[1:]]
    return args


def parse_args(argv):
    team_dir = role = None
    while argv and argv[0] in ("--team-dir", "--role"):
        if len(argv) < 2:
            die(f"{argv[0]} needs a value")
        if argv[0] == "--team-dir":
            team_dir = argv[1]
        else:
            role = argv[1]
        argv = argv[2:]
    if bool(team_dir) != bool(role):
        die("--team-dir and --role go together")
    if "--" not in argv or argv.index("--") != 1 or len(argv) < 3:
        die("usage: herdr-sandbox [--team-dir DIR --role ROLE] <worktree> -- <command> [args...]")
    return team_dir, role, Path(argv[0]).expanduser().resolve(), argv[2:]


def main():
    team_dir, role, worktree, command = parse_args(sys.argv[1:])
    if not worktree.is_dir():
        die(f"not a directory: {worktree}")

    common_git = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=worktree))
    if common_git.name != ".git":
        die(f"unsupported repository layout: common git dir is {common_git}")
    repo = common_git.parent
    if worktree == repo:
        die("refusing to sandbox the main checkout; run agents in a linked worktree")

    try:
        grants = herdr_grants.load(repo)
    except herdr_grants.GrantError as error:
        die(str(error))

    try:
        filtered = herdr_netfilter.mode(herdr_grants.read_yaml(SETTINGS, {})) == "required"
    except ValueError as error:
        die(f"{SETTINGS}: {error}")
    if filtered and (reason := herdr_netfilter.problem()):
        die(f"refusing to start an agent without its network filter: {reason}")

    upstream = os.environ.get("HERDR_SOCKET_PATH")
    pane_id = os.environ.get("HERDR_PANE_ID")
    filter_dir = None
    server = None
    if upstream and pane_id:
        runtime = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        filter_dir = tempfile.mkdtemp(prefix="herdr-sandbox-", dir=runtime)
        server = herdr_filter.Filter(upstream, pane_id, team_dir, role).start(filter_dir)
    elif role:
        die("a team member needs herdr's socket and pane; run it in a herdr pane")

    branch = prompt = run = None
    if team_dir:
        team = herdr_team.load(team_dir)
        branch = team.get("branch")
        run = run_env(team)
        candidate = Path(team_dir) / "prompts" / f"{role}.md"
        prompt = candidate if candidate.is_file() else None
    bwrap = build_bwrap(worktree, common_git, grants, command, filter_dir, role, branch, prompt, run)
    if filtered:
        bwrap = herdr_netfilter.wrap(bwrap)
    child = subprocess.Popen(bwrap)
    # The terminal delivers Ctrl-C and friends to the whole foreground group,
    # so the child sees them directly. Ignore them here and wait for it.
    for sig in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP):
        signal.signal(sig, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, lambda *_: child.terminate())
    signal.signal(signal.SIGHUP, lambda *_: child.terminate())
    code = child.wait()

    if server:
        server.close()
        shutil.rmtree(filter_dir, ignore_errors=True)
    sys.exit(code if code >= 0 else 128 - code)


if __name__ == "__main__":
    main()
